{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "ESNext",
		"lib": [ "ESNext", "DOM" ],
		"types": [ "node" ],
		"target": "ESNext",
		"isolatedModules": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"strictNullChecks": true,
		"plugins": [
			{
				"name": "typescript-plugin-css-modules"
			}
		]
	},
	"include": [
		"./eslint.config.js",
		"packages/**/*.d.ts",
		"packages/**/*.js",
		"packages/**/*.ts",
		"packages/**/*.json",
		"packages/**/*.module.css",
	],
	"exclude": [
		"**/node_modules"
	]
}
