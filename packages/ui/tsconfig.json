{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"lib": [ "ESNext", "DOM", "DOM.Iterable" ],
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strictNullChecks": true
	},
	"include": [
		"src/**/*.tsx",
		"src/**/*.ts",
		"test/**/*.js",
		"../../global.d.ts"
	]
}
