---
import { Link } from "ui";
import { IconGithub, IconTelegram, IconInstagram, IconLeetcode, IconLogo, IconGitlab } from "ui/icons";
import { LANG, ROUTES_SOCIALS } from "~/consts";

import styles from "./footer.module.css";
import { t } from "./footer.translation";
import { classnames } from "ui/utils";

const socials = [
	{ label: "source", href: ROUTES_SOCIALS.GITHUB, Icon: IconGithub },
	{ label: "gitlab", href: ROUTES_SOCIALS.GITLAB, Icon: IconGitlab },
	{ label: "telegram", href: ROUTES_SOCIALS.TELEGRAM, Icon: IconTelegram },
	{ label: "instagram", href: ROUTES_SOCIALS.INSTAGRAM, Icon: IconInstagram },
	{ label: "leetcode", href: ROUTES_SOCIALS.LEETCODE, Icon: IconLeetcode }
];

const BUILD_DATE = new Intl.DateTimeFormat(LANG, {
	year: "numeric",
	month: "long",
	day: "2-digit",
	hour: "2-digit",
	minute: "2-digit"
}).format();

// TODO
const link = LANG === "en"
	? "https://ru.escapist-marginalia.tech/"
	: "https://escapist-marginalia.tech/"
---

<footer class={styles.footer}>
	<section class={styles.section}>
		<div class={styles.logo}>
			<IconLogo />
			<p>Eric Rovell</p>
		</div>
		<Link appearance="text" class={classnames(styles.text, styles.link)} href={link} variant="neutral">
			{t.ANOTHER_LANG}
		</Link>
		<p class={classnames(styles.text, styles.build)}>
			{t.BUILD}: {LANG.toUpperCase()} {BUILD_DATE}
		</p>
	</section>
	<section class={styles.section}>
		<nav class={styles.nav}>
			<ul class={styles.socials}>
				{socials.map(({ href, Icon, label }) => (
					<li>
						<Link href={href} appearance="ghost" icon title={label}>
							<Icon title={label} />
						</Link>
					</li>
				))}
			</ul>
		</nav>
		<p class={classnames(styles.text, styles.ai)}>
			{t.NO_AI}
		</p>
	</section>
</footer>
