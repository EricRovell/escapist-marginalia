---
import { ButtonScrollTop } from "ui";
import { LayoutBaseTitle } from "..";

import styles from "./layout-article.module.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<LayoutBaseTitle title={title} description={description}>
	<article class={styles.article} data-full-bleed>
		<slot />
		<ButtonScrollTop client:visible />
	</article>
</LayoutBaseTitle>
