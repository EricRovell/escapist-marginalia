---
import type { CollectionEntry } from "astro:content";

import { LayoutBase } from "..";

import stylesArticle from "~/styles/article.module.css";
import styles from "./layout-project.module.css";
import { ArticleHeader } from "~/components";

type Props = CollectionEntry<"projects">;

const { data } = Astro.props;
const { title, description, cover_src, date_created } = data;
---

<LayoutBase title={title} description={description}>
	<main class={styles.main} data-full-bleed>
		<ArticleHeader
			title={title}
			description={description}
			image={cover_src}
			date={date_created}
		/>
		<article class={stylesArticle.article} data-full-bleed>
			<slot />
		</article>
	</main>
</LayoutBase>
