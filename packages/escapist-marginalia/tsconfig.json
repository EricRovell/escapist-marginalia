{
	"extends": "astro/tsconfigs/strict",
	"exclude": [
		"dist",
		"dist-ru"
	],
	"include": [
		"./astro/types.d.ts",
		"**/*"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": [ "src/*" ]
		},
		"strictNullChecks": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": [ "node" ]
	}
}
