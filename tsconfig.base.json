{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"declaration": true,
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"strictNullChecks": true,
		"types": []
	},
	"include": [
		"./src/**/*.ts",
		"./src/**/*.js",
		"./*.js",
		"./*.ts",
		"**/*.d.ts",
		"../../global.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}
